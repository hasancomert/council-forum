# Ortam değişkenleri. Kopyala ve doldur: Copy-Item .env.example .env   (sunucuda: cp .env.example .env)
# .env repoya girmez (.gitignore). Gerçekten tanımlı bir ortam değişkeni .env'dekini ezer.
# Geliştirmede yalnızca DEBUG=1 yeter; boş bırakılanlar geliştirme varsayılanını kullanır.

# 1 = geliştirme (hata sayfası, test anahtarları, HTTPS yok). Yayında boş ya da 0.
DEBUG=1

# Yayında zorunlu. Üretmek için:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Virgülle ayrılmış. Ör. forum.com.tr,www.forum.com.tr
ALLOWED_HOSTS=
# Yalnızca başka bir alan adından form gönderilecekse. Ör. https://forum.com.tr
CSRF_TRUSTED_ORIGINS=

# Boşsa SQLite (db.sqlite3). Sunucuda: postgres:///forum (yerel soket, şifresiz)
DATABASE_URL=

# HSTS süresi (saniye). Boşsa 1 yıl. İlk yayında 3600 ile başla, HTTPS sorunsuzsa sil.
HSTS_SECONDS=

# SMTP (587, STARTTLS). EMAIL_HOST boşsa e-postalar konsola yazılır.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Gönderen adresi, ör. Forum <noreply@forum.com.tr>
DEFAULT_FROM_EMAIL=
# 500 hatalarının gideceği adresler, virgülle ayrılmış
ADMINS=

# Cloudflare Turnstile. Geliştirmede boş: her zaman geçen test anahtarları kullanılır.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 5651 tanıtıcı bilgiler ve KVKK veri sorumlusu (iletişim sayfası). Yayında zorunlu.
# Gerçek kişiysen ad soyad, şirketse unvan. Adres tebligat adresi olmalı.
SITE_OWNER=
CONTACT_ADDRESS=
# Hukuka aykırı içerik bildirimi ve KVKK başvuruları bu adrese gelir.
CONTACT_EMAIL=

# İnternetsiz mod ve LoRa eşitleme (11. adım). Normal yayında hepsi boş kalır; testler bunları yok sayar.
# 1 = internetsiz: kayıtta CAPTCHA ve e-posta doğrulaması yok, hesap hemen açılır.
OFFLINE=
# FORUM kural sayılarının üzerine yazılan JSON, tek satır. Demo örneği (0.003 gün ≈ 4 dakika):
# FORUM_OVERRIDES={"QUORUM_MIN": 2, "MIN_ACCOUNT_AGE_DAYS": 0, "PROPOSAL_VOTING_DAYS": 0.003, "REQUEST_DISCUSSION_DAYS": 0.002, "REQUEST_VOTING_DAYS": 0.003, "PANEL_CACHE_SECONDS": 0}
FORUM_OVERRIDES=
# SQLite dosyasının adı, boşsa db.sqlite3. Aynı bilgisayarda iki düğüm denemek için ör. node2.sqlite3
SQLITE_NAME=
# Eşitleme: boş ya da 0 = kapalı, 1 = hakem düğüm (oylamaları sonuçlandırır), 2 = öbür düğüm.
SYNC_NODE=
# Modemin seri portu (ör. COM5) ya da sahte hat: socket://127.0.0.1:9100
SYNC_PORT=
# İki düğümde aynı imza anahtarı; SYNC_NODE doluyken zorunlu. Başka gruplardan farklı olsun.
SYNC_KEY=
